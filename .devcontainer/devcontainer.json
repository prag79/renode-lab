{
  "name": "Renode Lab",
  "image": "ghcr.io/prag79/renode-lab:latest",

  "remoteUser": "student",

  "containerEnv": {
    "LAB_GUI": "1",
    "DISPLAY": ":1"
  },

  "postStartCommand": "/usr/local/bin/entrypoint.sh true",

  "forwardPorts": [6080, 1234],
  "portsAttributes": {
    "6080": {
      "label": "Renode noVNC desktop",
      "onAutoForward": "notify",
      "visibility": "private"
    },
    "1234": {
      "label": "Renode telnet monitor",
      "onAutoForward": "silent",
      "visibility": "private"
    }
  },

  "postAttachCommand": "printf '\\n\\033[1;36mRenode lab ready — labs 00–07 + optional 08 (multi-node IoT).\\033[0m\\n\\n' && lab list",

  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "16gb"
  }
}
