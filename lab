#!/usr/bin/env bash
# /usr/local/bin/lab - dispatcher for the Renode starter exercises.
# Usage: lab {list|00|01|02|03|04|05|06|07|08|monitor|shell}
#        (lab 00 is also reachable as `lab demo` for back-compat.)
#
# On first run of `lab NN`, the canonical (root-owned, image-baked)
# lab dir under $LABS_ROOT is mirrored into $WORK_ROOT/<lab-name>/
# so the student can edit the `.resc`/`.repl`/source files without
# touching the read-only image. `cp -ru` is idempotent: re-running
# `lab NN` won't clobber edits, but will pull in any new files
# added upstream.
#
# After the mirror, the script `cd`s into the work copy and runs
# Renode from there, so relative `@` paths in the `.resc` resolve
# against the student's editable copy.

set -e

LABS_ROOT="${LABS_ROOT:-/labs}"
WORK_ROOT="${WORK_ROOT:-$HOME/work}"

# GUI mode: when LAB_GUI=1, entrypoint.sh has started Xvfb/x11vnc/
# websockify on DISPLAY=:1, so Renode should run WITHOUT --disable-gui
# and export DISPLAY so analyzer windows (LEDAnalyzer, LCDAnalyzer,
# GPIO widgets, ...) can render into the noVNC desktop on port 6080.
# Default (LAB_GUI unset or 0) is pure headless console operation.
if [[ "${LAB_GUI:-0}" == "1" ]]; then
  export DISPLAY="${DISPLAY:-:1}"
  RENODE_GUI_FLAGS=""
else
  RENODE_GUI_FLAGS="--disable-gui"
fi

prepare_workdir() {
  local lab="$1"
  local src="$LABS_ROOT/$lab"
  local dst="$WORK_ROOT/$lab"
  if [ ! -d "$src" ]; then
    echo "lab: no such lab '$lab' under $LABS_ROOT" >&2
    exit 1
  fi
  mkdir -p "$dst"
  # `cp -rn` (no-clobber) NEVER overwrites an existing file in $dst.
  # This is the right semantics for a student workdir: edits the student
  # made in ~/work/<lab>/ survive even when the GHCR image is rebuilt
  # (which gives /labs/ files fresh mtimes). `cp -ru` (update) would
  # silently clobber student edits on every image rebuild — that's the
  # bug this fixes. New files added upstream still get pulled in; to
  # reset a lab entirely, `rm -rf ~/work/<lab>/` and re-run `lab NN`.
  cp -rn "$src/." "$dst/"
  cd "$dst"
}

cmd="${1:-list}"; shift || true

case "$cmd" in
  list|"")
    echo "Available labs (00–07 core, 08 optional capstone):"
    echo "  00       - bare-metal ARM Cortex-A9 + SmartTimer MMIO demo (also: lab demo)"
    echo "  01       - bundled STM32F4 demo (sanity check)"
    echo "  02       - Linux on SiFive HiFive Unleashed (RISC-V)"
    echo "  03       - custom RV64 SoC + bare-metal hello world"
    echo "  04       - bare-metal on a SiFive FE310 (HiFive1): UART + GPIO blink"
    echo "  05       - FE310 timer interrupts: blink from a CLINT ISR"
    echo "  06       - headless regression testing with the Robot framework"
    echo "  07       - model your own peripheral (custom C# timer IP)"
    echo "  08       - (optional) multi-node IoT network: 3x FE310 over a shared UART bus"
    echo "  monitor  - plain Renode interactive monitor"
    echo
    echo "Run with: lab 00 | lab 01 | lab 02 | lab 03 | lab 04 | lab 05 | lab 06 | lab 07 | lab 08 | lab monitor"
    echo "Working copies live under: $WORK_ROOT/<lab-name>/"
    ;;

  01|01-bundled-stm32f4)
    prepare_workdir 01-bundled-stm32f4
    exec renode $RENODE_GUI_FLAGS --console stm32f4.resc
    ;;

  02|02-linux-on-hifive)
    prepare_workdir 02-linux-on-hifive
    exec renode $RENODE_GUI_FLAGS --console linux-hifive.resc
    ;;

  03|03-custom-soc)
    prepare_workdir 03-custom-soc
    make
    exec renode $RENODE_GUI_FLAGS --console renode/mini-rv.resc
    ;;

  04|04-sifive-fe310)
    prepare_workdir 04-sifive-fe310
    make
    exec renode $RENODE_GUI_FLAGS --console renode/hifive1.resc
    ;;

  05|05-fe310-interrupts)
    prepare_workdir 05-fe310-interrupts
    make
    exec renode $RENODE_GUI_FLAGS --console renode/timer-irq.resc
    ;;

  06|06-robot-testing)
    prepare_workdir 06-robot-testing
    make
    # renode-test is Renode's Robot Framework runner. Prefer the PATH
    # symlink; fall back to the portable install location.
    if command -v renode-test >/dev/null 2>&1; then
      exec renode-test tests/uart.robot
    else
      exec /opt/renode/renode-test tests/uart.robot
    fi
    ;;

  07|07-custom-peripheral)
    prepare_workdir 07-custom-peripheral
    make
    exec renode $RENODE_GUI_FLAGS --console renode/custom-timer.resc
    ;;

  08|08-multi-node-iot)
    prepare_workdir 08-multi-node-iot
    make
    exec renode $RENODE_GUI_FLAGS --console renode/iot-net.resc
    ;;

  00|00-Demo|demo|Demo)
    prepare_workdir 00-Demo
    make
    exec renode $RENODE_GUI_FLAGS --console bare_demo.resc
    ;;

  monitor|repl)
    exec renode $RENODE_GUI_FLAGS --console
    ;;

  shell)
    exec bash
    ;;

  -h|--help|help)
    echo "usage: lab {list|00|01|02|03|04|05|06|07|08|monitor|shell}"
    echo
    echo "On first invocation, lab NN copies /labs/<NN-...>/ into"
    echo "$WORK_ROOT/<NN-...>/ so you can edit it. Re-run 'lab NN'"
    echo "from anywhere -- the existing working copy is reused."
    echo
    echo "Aliases: 'lab demo' and 'lab Demo' both map to lab 00 (back-compat)."
    ;;

  *)
    echo "lab: unknown command '$cmd'" >&2
    echo "usage: lab {list|00|01|02|03|04|05|06|07|08|monitor|shell}" >&2
    exit 1
    ;;
esac
