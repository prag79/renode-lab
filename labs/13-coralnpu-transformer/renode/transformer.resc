:name: Transformer robot policy accelerated by a Coral NPU (RISC-V)
:description: A bare-metal RV64 robot controller runs an int8 transformer policy (command -> intent -> skills -> actuator) and offloads its matmuls to a Google Coral NPU (CPU.CoralNPU), comparing per-core instruction counts.

mach create "coral"

# Compile and load the actuator peripheral (lab 07/12 pattern).
i @peripherals/RobotActuator.cs

machine LoadPlatformDescription @renode/transformer.repl

# Stage the Coral NPU kernel into the NPU's instruction TCM (offset 0).
# We prefer a locally-fetched copy (tools/fetch_npu_kernel.sh -> binaries/)
# and fall back to Antmicro's hosted sample; if neither is reachable the
# transformer still runs on the host and the NPU phase reports "no kernel".
python """
import os
# Prefer the real transformer kernel (functional offload); fall back to a
# fetched copy, then to Antmicro's add sample (interface-only). Build the
# real one with tools/build_kernel.sh.
KERNELS = [
    ("coralnpu/kernel/npu_transformer.bin", "transformer kernel (functional offload)"),
    ("binaries/coralnpu_kernel.bin",        "prebuilt kernel"),
]
KERNEL_URL = "@https://dl.antmicro.com/projects/renode/coralnpu_v2_hello_world_add_floats.bin-s_65648-0e3f5d6ae173fa2e06f6b5f91906ef721516de4c"
machine = monitor.Machine
loaded = False
for path, desc in KERNELS:
    if os.path.exists(path):
        try:
            monitor.Parse("npu LoadBinary @%s 0" % path)
            print "Coral NPU kernel: loaded %s (%s)" % (path, desc)
            loaded = True
            break
        except Exception as e:
            print "Coral NPU kernel: failed to load %s (%s)" % (path, str(e))
if not loaded:
    try:
        monitor.Parse("npu LoadBinary %s 0" % KERNEL_URL)
        print "Coral NPU kernel: loaded Antmicro add sample (interface-only; host runs the policy)."
        print "  For a FUNCTIONAL offload, build the transformer kernel: tools/build_kernel.sh"
    except Exception as e:
        print "Coral NPU kernel: NOT loaded (%s); host will run the policy." % str(e)
"""

# Per-core instruction counting -- the same methodology as Antmicro's
# official Coral demo. On the marker lines the firmware prints, snapshot
# each core's ExecutedInstructions and print the delta so you can compare
# the policy's matmul cost on the host CPU against the Coral NPU.
#
# NOTE on the mechanism: `AddLineHook` is a Monitor *extension* method on
# IUART, not an instance method -- calling `uart.AddLineHook(...)` from
# Python fails ("'NS16550' object has no attribute 'AddLineHook'"). Each
# hook also runs in its own isolated Python engine, so a hook string cannot
# see functions defined here. The supported fix (renode #680) is to install
# the hook from *this* python engine via the static extension method,
# passing our predicate + callback objects directly -- they then share this
# engine's state (_snap).
python """
machine = monitor.Machine
uart = machine["sysbus.uart"]
_CORES = [("host cpu", "sysbus.cpu"), ("Coral NPU", "sysbus.npu")]
_snap = {}

def _read(path):
    try:
        return machine[path].ExecutedInstructions
    except Exception:
        return None

def coral_reset(line=None):
    _snap.clear()
    for _, path in _CORES:
        v = _read(path)
        if v is not None:
            _snap[path] = v

def coral_print(line=None):
    print "\n--- executed instructions (this phase) ---"
    for label, path in _CORES:
        cur = _read(path)
        if cur is None:
            continue
        if path == "sysbus.npu":
            print "  %-11s %d  (NPU, cumulative)" % (label + ":", cur)
        else:
            print "  %-11s %d" % (label + ":", cur - _snap.get(path, cur))
    print "------------------------------------------"

_add = Antmicro.Renode.Hooks.UartHooksExtensions.AddLineHook
_add(uart, lambda line: '# host_policy_start' in line, coral_reset)
_add(uart, lambda line: '# host_policy_done'  in line, coral_print)
_add(uart, lambda line: '# npu_infer_start'   in line, coral_reset)
_add(uart, lambda line: '# npu_infer_done'    in line, coral_print)
"""

macro reset
"""
    sysbus LoadELF @host.elf
"""
runMacro $reset

showAnalyzer sysbus.uart

start
