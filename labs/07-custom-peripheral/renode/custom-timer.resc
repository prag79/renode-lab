:name: Custom timer IP on a RISC-V SoC
:description: Compile a hand-written C# peripheral and run firmware that uses it.

mach create "custom-soc"

# Compile and load our peripheral. Renode detects the .cs extension and
# builds it into the running process; the type then becomes available to
# the platform description below as Timers.SimpleTimer.
i @peripherals/SimpleTimer.cs

machine LoadPlatformDescription @renode/custom-timer.repl

macro reset
"""
    sysbus LoadELF @firmware.elf
"""

runMacro $reset
# Full sysbus path required — bare `uart` is not resolved here.
# Headless fallback: `sysbus.uart CreateFileBackend @/tmp/uart.log true`
# then `tail -f /tmp/uart.log` in another terminal.
showAnalyzer sysbus.uart
start
