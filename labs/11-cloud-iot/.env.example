# Copy to .env and fill in for your own free-tier account.
# Load it before running the bridge, e.g.:   set -a; . ./.env; set +a
# NEVER commit .env or the certs/ directory (both are git-ignored).

# ---- AWS IoT Core (--cloud aws) ----
# Endpoint: AWS IoT console -> Settings -> "Device data endpoint"
AWS_IOT_ENDPOINT=xxxxxxxxxxxxx-ats.iot.<region>.amazonaws.com
AWS_IOT_TOPIC=renode/telemetry
AWS_IOT_CLIENT_ID=renode-sim-01
# Certificate files downloaded when you created the "Thing" (defaults
# below match tools/bridge.py; place them in labs/11-cloud-iot/certs/):
#   certs/AmazonRootCA1.pem
#   certs/device.pem.crt
#   certs/private.pem.key

# ---- Azure IoT Hub (--cloud azure) ----
# Device connection string: IoT Hub -> Devices -> <your device> ->
# "Primary connection string"
AZURE_IOT_CONNECTION_STRING=HostName=<hub>.azure-devices.net;DeviceId=renode-sim-01;SharedAccessKey=<key>
