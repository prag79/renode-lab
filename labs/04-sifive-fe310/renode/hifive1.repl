// SiFive FE310-G000 (the SoC on the HiFive1 board), trimmed to the
// blocks this lab actually touches. Addresses match the real
// datasheet and Renode's own platforms/cpus/sifive-fe310.repl, so
// everything you poke here is exactly where it lives on silicon.

cpu: CPU.RiscV32 @ sysbus
    cpuType: "rv32imac_zicsr_zifencei"
    privilegedArchitecture: PrivilegedArchitecture.Priv1_10
    timeProvider: clint

// 16 KiB data tightly-integrated memory. This is all the RAM the
// FE310 has on-chip; we link .text/.data/.bss + stack into it.
dtim: Memory.MappedMemory @ sysbus 0x80000000
    size: 0x4000

// Mask ROM holds the reset vector on real hardware. We LoadELF and
// jump straight to _start, so it stays empty here.
maskRom: Memory.MappedMemory @ sysbus 0x1000
    size: 0x1000

clint: IRQControllers.CoreLevelInterruptor @ sysbus 0x02000000
    [0,1] -> cpu@[3,7]
    frequency: 62000000

plic: IRQControllers.PlatformLevelInterruptController @ sysbus 0x0C000000
    0 -> cpu@11
    numberOfSources: 52
    numberOfContexts: 1

uart0: UART.SiFive_UART @ sysbus 0x10013000
    IRQ -> plic@3

gpio: GPIOPort.SiFive_GPIO @ sysbus 0x10012000
